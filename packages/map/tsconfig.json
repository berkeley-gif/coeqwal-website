{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@repo/map/client": ["./client"]
    },
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "hooks/**/*"],
  "exclude": ["node_modules", "dist"]
}